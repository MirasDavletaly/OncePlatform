# =============================================================================
# OncePlatform — настройки. Скопируйте файл: cp .env.example .env
# и заполните значения. Файл .env хранит секреты: не публикуйте его.
# Секреты генерируйте командой:  openssl rand -hex 32
# =============================================================================

# --- Адрес портала -----------------------------------------------------------
# Домен с A-записью на IP сервера. Caddy сам получит HTTPS-сертификат Let's Encrypt.
# Оставьте пустым для первичной проверки по http://<IP>:8080 (Claude подключить не получится).
DOMAIN=portal.example.kz

# Публичный адрес портала без «/» в конце. С доменом: https://<DOMAIN>.
# Без домена: http://<IP-сервера>:8080
APP_BASE_URL=https://portal.example.kz

# Часовой пояс для отображения дат и дедлайнов (Казахстан: UTC+5).
APP_TIMEZONE=Asia/Almaty

# Адрес, на котором приложение слушает внутри контейнера (менять не нужно).
LISTEN_ADDR=:8080

# Куда пробросить порт приложения на сервере. По умолчанию — только этот компьютер
# (за HTTPS-прокси). 8080 открывает доступ по http://<IP>:8080 всей сети: только для
# первой проверки, потом верните 127.0.0.1:8080.
HTTP_PORT_BIND=127.0.0.1:8080

# --- Tailscale (только для Synology: deploy/synology/docker-compose.yml) ----
# Для Synology этот файл кладётся рядом с compose: deploy/synology/.env
# Ключ авторизации: Tailscale admin console → Settings → Keys → Generate auth key.
TS_AUTHKEY=
# Имя машины портала в tailnet. Адрес будет https://algoritmi.<ваш-tailnet>.ts.net
# — его же укажите в APP_BASE_URL (а DOMAIN оставьте пустым).
TS_HOSTNAME=algoritmi

# --- База данных PostgreSQL -------------------------------------------------
POSTGRES_USER=portal
# Только латинские буквы и цифры (используется в адресе подключения): openssl rand -hex 24
POSTGRES_PASSWORD=change-me-use-openssl-rand-hex-24
POSTGRES_DB=portal
# Можно оставить пустым — адрес соберётся из трёх значений выше.
DATABASE_URL=

# --- Безопасность -------------------------------------------------------------
# Секрет для защиты форм от CSRF, не короче 32 символов: openssl rand -hex 32
CSRF_SECRET=replace-with-output-of-openssl-rand-hex-32

# --- Пользователи при первом запуске -------------------------------------
# Создаются, только если в базе ещё нет ни одного пользователя.
# Формат: логин:роль[:Имя], через запятую. Роли: admin (руководитель),
# coordinator (координатор), analyst (аналитик). Вход — по логину.
INITIAL_USERS=Alessio:admin,Dinara:coordinator,Miras:analyst
# Общий начальный пароль (не короче 8 символов). Каждый может сменить его
# в профиле, руководитель — задать новый в разделе «Пользователи».
INITIAL_PASSWORD=replace-with-your-own-value

# --- Файлы ------------------------------------------------------------------
# Максимальный размер одного загружаемого файла, МБ.
UPLOAD_MAX_MB=50
# Лимит размера запроса в Caddy: должен быть больше UPLOAD_MAX_MB.
CADDY_MAX_BODY=120MB
# Каталог файлов внутри контейнера (Docker-том uploads). Менять не нужно.
STORAGE_PATH=/data/uploads

# --- Резервные копии ----------------------------------------------------------
# Сколько дней хранить ежедневные архивы (том backups).
BACKUP_RETENTION_DAYS=14
# Время ежедневного бэкапа (по APP_TIMEZONE), ЧЧ:ММ.
BACKUP_TIME=02:30

# --- Демо-данные ---------------------------------------------------------------
# true — при первом запуске создать 12 демо-задач для пользователей выше.
# Для рабочей системы — false.
SEED_DEMO=false

# Уровень логов: debug, info, warn, error.
LOG_LEVEL=info
